# Copy to .env.local and fill in. Nothing here is required to run `npm run dev`,
# but without RESEND_API_KEY both forms return HTTP 501: the contact form falls
# back to a mailto: compose and the newsletter says sign-ups aren't wired up.

# --- Email (Resend) -------------------------------------------------------
# https://resend.com/api-keys — required for /api/contact and /api/subscribe.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
# Defaults to hello@xarktech.com if unset.
CONTACT_TO=hello@xarktech.com

# Verified sender. Must be a domain you've verified in Resend, otherwise sends
# are rejected. Falls back to Resend's onboarding sender, which only delivers
# to the account owner — fine for testing, not for production.
CONTACT_FROM="Xark website <hello@xarktech.com>"

# --- Newsletter (Resend Audiences) ---------------------------------------
# https://resend.com/audiences — the audience new subscribers are added to.
# /api/subscribe needs BOTH this and RESEND_API_KEY, or it returns 501.
RESEND_AUDIENCE_ID=

# --- Booking (optional) --------------------------------------------------
# Cal.com path only, no domain — e.g. "xark/intro" renders a link to
# https://cal.com/xark/intro. Leave empty and BookingLink renders nothing
# rather than pointing at an account that doesn't exist.
NEXT_PUBLIC_CAL_LINK=
